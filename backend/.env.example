# Endereço onde a API vai escutar (use 0.0.0.0 dentro de Docker)
HOST=127.0.0.1
PORT=3000

# Arquivo SQLite (é criado automaticamente na primeira execução)
DATABASE_URL=sqlite://nexus_feed.db

# Origens do frontend autorizadas pelo CORS, separadas por vírgula.
# Use * apenas em desenvolvimento.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Intervalo da atualização automática dos feeds, em minutos (0 desativa)
REFRESH_INTERVAL_MINUTES=15

# SOMENTE para desenvolvimento/testes: permite cadastrar feeds em localhost
# e redes privadas. Mantenha false em produção (proteção contra SSRF).
ALLOW_PRIVATE_URLS=false

# Nível de log (tracing)
RUST_LOG=nexus_feed_api=debug,tower_http=info
